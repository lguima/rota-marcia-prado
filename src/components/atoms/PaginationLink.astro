---
interface Props {
  href: string | undefined
  label: string
}

const { href, label } = Astro.props
---

<a
  href={href}
  class:list={['btn', { 'pointer-events-none opacity-50': !href }]}
  data-variant="ghost"
  aria-label={label}
  aria-disabled={!href ? 'true' : undefined}
  tabindex={!href ? -1 : undefined}
>
  <slot />
</a>

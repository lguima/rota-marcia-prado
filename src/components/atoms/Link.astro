---
interface Props {
  href: string | undefined
  target: string
}

const { href, ...props } = Astro.props

const isExternal = typeof href === 'string' && href.startsWith('http');
const rel = isExternal ? 'noopener noreferrer' : 'noopener';
---

<a
  {...props}
  href={href}
  rel={rel}
  target="_blank"
>
  <slot />
</a>

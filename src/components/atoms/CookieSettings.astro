---
import IconCookie from './IconCookie.astro'
---

<button
  id="privacy-preferences"
  class="hidden btn size-11 fixed bottom-5 left-5 z-50 rounded-full shadow-lg transition-all duration-300 transform hover:scale-110 focus:outline-none"
  type="button"
  data-variant="secondary"
  data-size="lg"
  aria-label="Gerenciar Preferências de Privacidade"
  data-cc="show-preferencesModal"
>
  <IconCookie class="size-6" />
</button>

<script>
  function getCookie(name: string): string | null {
    const value = `; ${document.cookie}`;
    const parts = value.split(`; ${name}=`);
    if (parts.length === 2) return parts.pop()?.split(';').shift() || null;
    return null;
  }

  const banner = document.getElementById('privacy-preferences');
  const cookieConsent = getCookie('cc_cookie');

  if (cookieConsent && banner) {
    banner.classList.remove('hidden');
  }
</script>

---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<div
  class="mx-auto flex w-full max-w-3xl flex-col items-center gap-3 text-center"
>
  <h1 class="text-3xl font-medium tracking-tight text-balance lg:text-4xl">
    {title}
  </h1>
  <p class="text-muted-foreground max-w-2xl text-base text-pretty">
    {description}
  </p>
</div>

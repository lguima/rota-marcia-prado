---
import IconChevronDown from '@components/atoms/IconChevronDown.astro'
import type { CollectionEntry } from 'astro:content'

export interface Props {
  faq: CollectionEntry<'faq'>
}

const { faq } = Astro.props
---

<details class="open:bg-secondary px-4">
  <summary>
    <h3 id={faq.id} class="sr-only">{faq.data.question}</h3>
    {faq.data.question}
    <IconChevronDown />
  </summary>
  <section class="text-muted-foreground text-base">
    {faq.data.answer}
  </section>
</details>

<script>
  function openTargetedAccordion() {
    const hash = window.location.hash;
    if (!hash) return;

    const targetElement = document.querySelector(hash);
    if (targetElement) {
      // Find the closest parent details tag and open it
      const detailsParent = targetElement.closest('details');
      if (detailsParent) {
        detailsParent.open = true;
      }
    }
  }

  // Listen for both immediate page loads and hash changes from clicks
  window.addEventListener('DOMContentLoaded', openTargetedAccordion);
  window.addEventListener('hashchange', openTargetedAccordion);
</script>

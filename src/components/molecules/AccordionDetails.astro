---
const { title } = Astro.props
---

<script>
  function openTargetedAccordion() {
    const hash = window.location.hash;
    if (!hash) return;

    const targetElement = document.querySelector(hash);
    if (targetElement) {
      // Find the closest parent details tag and open it
      const detailsParent = targetElement.closest('details');
      if (detailsParent) {
        detailsParent.open = true;
      }
    }
  }

  // Listen for both immediate page loads and hash changes from clicks
  window.addEventListener('DOMContentLoaded', openTargetedAccordion);
  window.addEventListener('hashchange', openTargetedAccordion);
</script>

<details>
  <summary>
    {title}
    <svg class="lucide lucide-chevron-down" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
  </summary>
  <h3 id={title.toLowerCase().replace(/\s+/g, "-")} class="sr-only">{title}</h3>
  <section class="text-muted-foreground text-base">
    <slot />
  </section>
</details>

---
import { type CollectionEntry } from 'astro:content'
import { formatDateLong, formatDateShort } from '@utils/date'

export interface Props {
  post: CollectionEntry<'article'>
}

const { post } = Astro.props
const { title, publishDate, category } = post.data
---

<a href={`/artigos/${post.id}/`} class="item flex flex-col xs:flex-row items-start">
  <section>
    <h3 class="lg:text-xl">
      {title}
    </h3>
    <p>
      <span class="badge" data-variant="secondary">
        {category}
      </span>
    </p>
  </section>
  <section>
    <p>
      <span class="hidden 4xs:inline">{formatDateLong(publishDate)}</span>
      <span class="inline 4xs:hidden">{formatDateShort(publishDate)}</span>
    </p>
  </section>
</a>

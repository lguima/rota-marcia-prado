---
import IconChevronLeft from '@components/atoms/IconChevronLeft.astro'
import IconChevronRight from '@components/atoms/IconChevronRight.astro'
import PaginationLink from '@components/atoms/PaginationLink.astro'

export interface Props {
  page: {
    data: any[]
    url: {
      current: string
      next?: string
      prev?: string
    }
    currentPage: number
    lastPage: number
    size: number
    total: number
  }
}

const { page } = Astro.props
---

<div class="3xs:flex-row flex flex-col items-center justify-center gap-4">
  <div class="text-muted-foreground w-28 text-center text-sm">
    {(page.currentPage - 1) * page.size + 1} a {
      Math.min(page.currentPage * page.size, page.total)
    } de {page.total}
  </div>

  <nav aria-label="pagination" class="flex justify-center">
    <ul class="flex flex-row items-center gap-1">
      <li>
        <PaginationLink href={page.url.prev} label="Ir para a página anterior">
          <IconChevronLeft />
        </PaginationLink>
      </li>

      <li>
        <PaginationLink href={page.url.next} label="Ir para a próxima página">
          <IconChevronRight />
        </PaginationLink>
      </li>
    </ul>
  </nav>
</div>

---
const isDev = import.meta.env.DEV

const { compact, ...rest } = Astro.props
---

{
  isDev ? (
    <div
      class:list={[
        'skeleton h-[36.25px]',
        {
          'w-[44.25]': compact,
          'w-[121.217px]': !compact,
        },
      ]}
    />
  ) : (
    <pagefind-modal-trigger
      {...(compact && { compact: 'true' })}
      {...rest}
      hide-shortcut
    />
  )
}

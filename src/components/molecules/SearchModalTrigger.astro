---
const isDev = import.meta.env.DEV

const { compact, ...rest } = Astro.props
---

{
  isDev ? (
    <div
      class:list={[
        'skeleton h-9',
        {
          'w-11': compact,
          'w-32': !compact,
        },
      ]}
    />
  ) : (
    <pagefind-modal-trigger
      {...(compact && { compact: 'true' })}
      {...rest}
      hide-shortcut
    />
  )
}

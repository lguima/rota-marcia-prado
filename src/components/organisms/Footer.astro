---
import RssIcon from '@components/atoms/RssIcon.astro'
import Separator from '@components/atoms/Separator.astro'
import site from '@config/site.mjs'

const currentYear = new Date().getFullYear()
---

<footer>
  <div class="mx-auto flex max-w-7xl flex-col flex-wrap gap-6 p-8">
    <nav
      aria-label="Rodapé"
      class="flex flex-wrap justify-center gap-x-12 gap-y-3 text-sm"
    >
      <a href="/perguntas-frequentes/" class="text-muted-foreground">
        Perguntas Frequentes
      </a>

      <a href="/publicacoes/" class="text-muted-foreground"> Publicações </a>
      <a href="/categorias/" class="text-muted-foreground"> Categorias </a>
      <a href="/topicos/" class="text-muted-foreground"> Tópicos </a>
      <a href="/autorias/" class="text-muted-foreground"> Autorias </a>

      <a
        href="/rss.xml"
        title="RSS Feed"
        target="_blank"
        class="text-muted-foreground"
      >
        <span class="sr-only">RSS Feed</span>
        <RssIcon class="size-5" />
      </a>
    </nav>

    <Separator />

    <p class="text-muted-foreground text-center text-xs">
      &copy; {currentYear}&nbsp;
      {site.name}. Todos os direitos reservados.
    </p>
  </div>
</footer>

---
import site from '@config/site.mjs'
import { getMenuItems } from '@utils/collections/menu'

import RssIcon from '@components/atoms/RssIcon.astro'
import Separator from '@components/atoms/Separator.astro'

const menu = await getMenuItems()

const currentYear = new Date().getFullYear()
---

<footer>
  <div class="mx-auto flex max-w-7xl flex-col flex-wrap gap-6 p-8">
    <nav
      aria-label="Rodapé"
      class="flex flex-wrap justify-center gap-x-12 gap-y-3 text-sm"
    >
      {
        menu.map(item => (
          <a href={item.data.href} class="text-muted-foreground">
            {item.data.text}
          </a>
        ))
      }

      <a
        href="/rss.xml"
        title="RSS Feed"
        target="_blank"
        class="text-muted-foreground"
      >
        <span class="sr-only">RSS Feed</span>
        <RssIcon class="size-5" />
      </a>
    </nav>

    <Separator />

    <p class="text-muted-foreground text-center text-xs">
      &copy; {currentYear}&nbsp;
      {site.name}. Todos os direitos reservados.
    </p>
  </div>
</footer>

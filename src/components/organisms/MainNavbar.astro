---
import { Image } from 'astro:assets'

import EmergencyButton from '@components/molecules/EmergencyButton.astro'
import SearchModalTrigger from '@components/molecules/SearchModalTrigger.astro'
import ThemeSwitcher from '@components/atoms/ThemeSwitcher.astro'
import IconX from '@components/atoms/IconX.astro'
import IconMenu from '@components/atoms/IconMenu.astro'

import site from '@config/site.mjs'
import media from '@config/media.mjs'
import IconCornerDownRight from '@components/atoms/IconCornerDownRight.astro'
---

<nav
  id="smart-nav"
  class="bg-secondary border-b fixed top-0 inset-x-0 z-50 transition-transform duration-300 ease-in-out translate-y-0"
>
  <!-- Main Nav Bar -->
  <div class="mx-auto h-14 w-full max-w-7xl px-5 lg:px-8 flex items-center justify-between relative z-50">
    <a href="/" class="flex shrink-0 items-center gap-1">
      <Image
        src={`${media.url}/rota-marcia-prado/image/upload/v1780795286/rota-marcia-prado-logo-thumbnail.png`}
        alt={site.name}
        class="h-10 w-10 rounded-full border-2 object-cover"
        width={40}
        height={40}
        priority
      />
      <span
        class="hidden text-sm font-medium whitespace-nowrap 2xs:inline"
      >
        {site.name}
      </span>
    </a>

    <!-- Desktop Menu -->
    <div class="hidden sm:flex items-center gap-6 text-sm font-medium">
      <a
        href="/perguntas-frequentes/"
        class="focus-visible:border-ring focus-visible:ring-ring/50 aria-invalid:border-destructive aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 hover:bg-accent hover:text-accent-foreground dark:hover:bg-accent/50 inline-flex h-8 shrink-0 items-center justify-center gap-1.5 rounded-md px-3 text-sm font-medium whitespace-nowrap transition-all outline-none focus-visible:ring-[3px] disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4"
      >
        Perguntas Frequentes
      </a>
    </div>

    <div class="flex items-center gap-2">
      <!-- Hamburger Button -->
      <button id="menu-toggle" type="button" class="btn sm:hidden" data-variant="ghost" data-size="icon" aria-label="Alternar menu" aria-expanded="false">
        <IconMenu id="hamburger-icon" class="block" />
        <IconX id="close-icon" class="hidden" />
      </button>

      <SearchModalTrigger compact />

      <ThemeSwitcher />

      <EmergencyButton />
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div
    id="mobile-menu"
    class="sm:hidden absolute top-14 inset-x-0 bg-secondary border-b shadow-lg flex flex-col p-4 space-y-3 font-medium"
  >
    <a href="/perguntas-frequentes/" class="py-1 flex items-center gap-2">
      <IconCornerDownRight class="size-4" />
      Perguntas Frequentes
    </a>
  </div>
</nav>

<script>
  // DOM Elements
  const nav = document.getElementById('smart-nav');
  const toggleBtn = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  let isMenuOpen = false;
  let lastScrollY = window.scrollY;
  const threshold = 50;

  // Helper function to force-close the mobile menu cleanly
  function closeMobileMenu() {
    if (!isMenuOpen) return;

    isMenuOpen = false;
    toggleBtn?.setAttribute('aria-expanded', 'false');
    mobileMenu?.classList.add('hidden');
    hamburgerIcon?.classList.remove('hidden');
    closeIcon?.classList.add('hidden');
  }

  // 1. Hamburger Toggle Logic
  if (toggleBtn && mobileMenu && hamburgerIcon && closeIcon) {
    mobileMenu.classList.toggle('hidden', !isMenuOpen);

    toggleBtn.addEventListener('click', (event) => {
      // Prevent this click from immediately triggering the document click listener below
      event.stopPropagation();

      isMenuOpen = !isMenuOpen;
      toggleBtn.setAttribute('aria-expanded', isMenuOpen.toString());

      mobileMenu.classList.toggle('hidden', !isMenuOpen);
      hamburgerIcon.classList.toggle('hidden', isMenuOpen);
      closeIcon.classList.toggle('hidden', !isMenuOpen);
    });
  }

  // 2. Click Outside Logic
  document.addEventListener('click', (event) => {
    const target = event.target as Node;

    // If the menu is open and the click happened entirely outside the nav element, close it
    if (isMenuOpen && nav && !nav.contains(target)) {
      closeMobileMenu();
    }
  });

  // 3. Auto-Hide & Scroll Close Logic
  if (nav) {
    window.addEventListener('scroll', () => {
      const currentScrollY = window.scrollY;
      const isScrollingDown = currentScrollY > lastScrollY;
      const isPastThreshold = currentScrollY > threshold;

      if (isScrollingDown && isPastThreshold) {
        // If the user actively scrolls down, shut the mobile dropdown open state first
        if (isMenuOpen) {
          closeMobileMenu();
        }
        // Hide the top navbar structure seamlessly
        nav.classList.remove('translate-y-0');
        nav.classList.add('-translate-y-full');
      } else {
        // Slide the menu back into view when scrolling up
        nav.classList.remove('-translate-y-full');
        nav.classList.add('translate-y-0');
      }

      lastScrollY = currentScrollY;
    });
  }
</script>

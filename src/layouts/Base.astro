---
import Head from '@components/Head.astro'
import SearchModal from '@components/organisms/SearchModal.astro'

const { title, description, ...rest } = Astro.props
---

<!doctype html>
<html id="base-layout" lang={Astro.currentLocale} {...rest}>
  <Head title={title} description={description}>
    <slot name="structured-data" slot="structured-data" />
  </Head>

  <body>
    <slot />
    <SearchModal />
  </body>
</html>

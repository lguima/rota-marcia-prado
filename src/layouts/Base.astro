---
import Head from '@components/Head.astro'
import SearchModal from '@components/organisms/SearchModal.astro'

interface Props {
  index?: boolean;
  title: string;
  description: string;
  breadcrumb?: { text: string; href?: string }[];
}

const { index = false, title, description, ...rest } = Astro.props
---

<!doctype html>
<html id="base-layout" class="scroll-smooth scroll-pt-18" lang={Astro.currentLocale} {...rest}>
  <Head index={index} title={title} description={description}>
    <slot name="structured-data" slot="structured-data" />
  </Head>

  <body>
    <slot />
    <SearchModal />
  </body>
</html>

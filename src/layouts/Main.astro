---
import Base from './Base.astro'
import Header from '@components/organisms/Header.astro'
import Footer from '@components/organisms/Footer.astro'
import Breadcrumb from '@components/molecules/Breadcrumb.astro'
import BackToTop from '@components/atoms/BackToTop.astro'

import '../styles/global.css'

interface Props {
  index?: boolean;
  title: string;
  description: string;
  breadcrumb?: { text: string; href?: string }[];
}

const { index = false, title, description, breadcrumb, ...rest } = Astro.props
---

<Base index={index} title={title} description={description} {...rest}>
  <slot name="structured-data" slot="structured-data" />

  <Header />

  <main class="mx-auto max-w-7xl overflow-x-hidden px-5 pt-18 pb-4 lg:px-8">
    {breadcrumb && breadcrumb.length > 0 && (
      <Breadcrumb items={breadcrumb} />
    )}
    <slot />
    <BackToTop />
  </main>

  <Footer />
</Base>

---
import { getCollection } from "astro:content"
import type { GetStaticPaths } from "astro"
import Main from "@layouts/Main.astro";
import PostItem from "@components/molecules/PostItem.astro"
import Pagination from "@components/molecules/Pagination.astro"
import content from "@config/content.mjs"

export const getStaticPaths = (async ({ paginate }) => {
  const allPosts = await getCollection("article")
  const sortedPosts = allPosts.sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf())

  return paginate(sortedPosts, {
    pageSize: content.posts.pagination.pageSize,
  })
}) satisfies GetStaticPaths

const { page } = Astro.props

const pageTitle = page.currentPage === 1 ? 'Publicações' : `Publicações - Página ${page.currentPage}`
---

<Main title={pageTitle} description="">
  <section class="pt-6 pb-6 lg:pt-10 lg:pb-10">
    <div class="mx-auto flex max-w-7xl flex-col gap-12 px-5 lg:gap-16 lg:px-8">
      <div class="flex w-full max-w-3xl flex-col gap-3 mx-auto items-center text-center">
        <!-- <span class="text-primary text-base font-medium">Benefits</span> -->
        <h1 class="text-3xl font-medium tracking-tight text-balance lg:text-4xl">
          Publicações
        </h1>
        <p class="text-muted-foreground max-w-2xl text-base text-pretty">
           Todas as publicações
        </p>
      </div>
    </div>
  </section>

  <section class="pt-6 pb-6 lg:pt-10 lg:pb-10">
    <div class="mx-auto max-w-7xl px-5 lg:px-8 flex flex-col gap-6 lg:gap-8">
      <div class="flex w-full flex-col gap-4">
        {page.data.map((post) => <PostItem post={post} />)}
      </div>

      <Pagination page={page} />
    </div>
  </section>
</Main>

---
import { render } from "astro:content"
import { getPublishedArticles, getSimilarArticles } from '@utils/collections/article'
import { getActiveAlerts } from '@utils/collections/alert'
import { getPublishedAnnouncements } from '@utils/collections/announcement'
import { formatDate } from '@utils/date'
import Main from "@layouts/Main.astro";
import FeaturedPost from '@components/molecules/FeaturedPost.astro'
import Separator from '@components/atoms/Separator.astro'
import MegaphoneIcon from '@components/atoms/MegaphoneIcon.astro'
import TriangleAlertIcon from '@components/atoms/TriangleAlertIcon.astro'

export async function getStaticPaths() {
  const posts = await getPublishedArticles()
  const alerts = await getActiveAlerts()
  const announcements = await getPublishedAnnouncements()

  return posts.map((post) => {
    const matchedAlert = alerts.find((alert) => alert.data.post.id === post.id);
    const matchedAnnouncement = announcements.find((announcement) => announcement.data.post.id === post.id);

    return {
      params: { slug: post.id },
      props: {
        post,
        alert: matchedAlert || null,
        announcement: matchedAnnouncement || null
      },
    };
  });
}

const { post, alert, announcement } = Astro.props;
const { title, description, pubDate, category, author, tags } = post.data
const { Content } = await render(post)

const posts = await getPublishedArticles()
const similarPosts = getSimilarArticles(posts, post)

const formattedDate = formatDate(pubDate)

let Icon = null;
if (alert) Icon = TriangleAlertIcon;
else if (announcement) Icon = MegaphoneIcon;
---

<Main title={title} description={description}>
  <div class="mx-auto max-w-7xl px-5 lg:px-8 flex flex-col gap-3 lg:gap-4">
    <article class="flex flex-col gap-8 py-6 lg:py-10">
      <header class="flex flex-col gap-6">
        <div class="flex flex-wrap gap-2">
          {
            category && (
              <a href={`/categorias/${category.toLowerCase().replace(/\s+/g, "-")}/`}>
                <span
                  class:list={[
                    "badge",
                    {
                      "bg-danger/20 text-danger": alert?.data?.severity === 1,
                      "bg-warning/20 text-warning": alert?.data?.severity === 2,
                      "bg-info/20 text-info": announcement && !alert
                    }
                  ]}
                  data-variant="secondary"
                >
                  {Icon && <Icon data-icon="inline-start" />}
                  {category}
                </span>
              </a>
            )
          }
          {
            tags.map((tag) => (
              <a href={`/topicos/${tag.toLowerCase().replace(/\s+/g, "-")}/`}>
                <span data-slot="badge" data-variant="outline" class="inline-flex w-fit shrink-0 items-center justify-center gap-1 overflow-hidden rounded-full border px-2 py-0.5 text-xs font-medium whitespace-nowrap transition-[color,box-shadow] focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 aria-invalid:border-destructive aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 [&amp;&gt;svg]:pointer-events-none [&amp;&gt;svg]:size-3 border-border text-foreground [a&amp;]:hover:bg-accent [a&amp;]:hover:text-accent-foreground">
                  {tag}
                </span>
              </a>
            ))
          }
        </div>

        <h1 class="text-4xl leading-tight font-bold tracking-tight md:text-5xl lg:text-6xl">
          {title}
        </h1>

        <p class="text-muted-foreground text-xl leading-relaxed">
          {description}
        </p>

        <div class="flex flex-col justify-between gap-4 pt-4 sm:flex-row sm:items-center">
          <div class="flex items-center gap-3">
            <div>
              <p>
                Por&nbsp;
                <a
                  class="font-semibold hover:underline"
                  href={`/autorias/${author.toLowerCase().replace(/\s+/g, "-")}/`}
                >
                {author}
              </a>
              </p>
            </div>
          </div>
          <div class="text-muted-foreground flex items-center gap-4 text-sm">
            <div class="flex items-center gap-1">
              <svg class="lucide lucide-calendar h-4 w-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v4"></path><path d="M16 2v4"></path><rect width="18" height="18" x="3" y="4" rx="2"></rect><path d="M3 10h18"></path></svg>
              <span>{formattedDate}</span>
            </div>
          </div>
        </div>
      </header>

      <Separator />

      <div class="prose prose-gray dark:prose-invert max-w-none">
        <Content />
      </div>

      {
        similarPosts.length == 0 && (
          <div class="pt-4 text-center">
            <a href="/">
              <button type="button" class="btn" data-variant="link">
                <svg class="lucide lucide-arrow-left-icon lucide-arrow-left" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg> Voltar ao início
              </button>
            </a>
          </div>
        )
      }
    </article>
  </div>

  {
    similarPosts.length > 0 && (
      <section class="py-6 lg:py-10">
        <div class="mx-auto max-w-7xl px-5 lg:px-8 flex flex-col gap-6 lg:gap-8">
          <Separator />

          <div class="flex gap-5 lg:gap-9">
            <div class="flex w-full max-w-3xl flex-col gap-3 items-start text-left flex-1">
              <h3 class="font-medium tracking-tight text-balance text-1xl lg:text-2xl">
                Publicações relacionadas
              </h3>
            </div>
          </div>

          <div class="grid w-full grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3 lg:gap-9">
            {similarPosts.map((similarPost) => (
              <FeaturedPost post={similarPost} />
            ))}
          </div>

          <div class="pt-4 text-center">
            <a href="/">
              <button type="button" class="btn" data-variant="link">
                <svg class="lucide lucide-arrow-left-icon lucide-arrow-left" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg> Voltar ao início
              </button>
            </a>
          </div>
        </div>
      </section>
    )
  }
</Main>

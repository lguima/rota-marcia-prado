---
import type { GetStaticPaths } from 'astro'
import { type CollectionEntry } from 'astro:content'

import content from '@config/content.mjs'
import { getPublishedArticles } from '@utils/collections/article'

import Main from '@layouts/Main.astro'
import PageHeader from '@components/molecules/PageHeader.astro'
import Pagination from '@components/molecules/Pagination.astro'
import PostItem from '@components/molecules/PostItem.astro'
import HouseIcon from '@components/atoms/HouseIcon.astro'
import UserIcon from '@components/atoms/UserIcon.astro'

export const getStaticPaths = (async ({ paginate }) => {
  const allPosts = await getPublishedArticles()
  const allAuthors = [...new Set(allPosts.map((post) => post.data.author))]

  return allAuthors.flatMap((author) => {
    const authorSlug = author.toLowerCase().replace(/\s+/g, '-')
    const authorPosts = allPosts
      .filter((post) => post.data.author === author)
      .sort(
        (a, b) =>
          new Date(b.data.publishDate).valueOf() -
          new Date(a.data.publishDate).valueOf(),
      )

    return paginate(authorPosts, {
      params: {
        author: authorSlug,
      },
      props: {
        author,
        authorSlug,
      },
      pageSize: content.authors.pagination.pageSize,
    })
  })
}) satisfies GetStaticPaths

type Props = {
  author: string
  authorSlug: string
  page: {
    data: CollectionEntry<'article'>[]
    currentPage: number
    lastPage: number
    size: number
    total: number
    url: {
      current: string
      next?: string
      prev?: string
    }
  }
}

const { author, page } = Astro.props

const pageTitle =
  page.currentPage === 1
    ? `Artigos por ${author}`
    : `Artigos por ${author} - Página ${page.currentPage}`

const pageDescription = `${page.total} ${page.total === 1 ? 'artigo' : 'artigos'} por ${author}`
---

<Main title={pageTitle} description={`Artigos de autoria de ${author}`} data-pagefind-ignore="all">
  <section class="py-6 lg:py-10">
    <div class="flex flex-col gap-12 lg:gap-16">
      <PageHeader title={author} description={pageDescription} />
    </div>
  </section>

  <section class="py-6 lg:py-10">
    <div class="flex flex-col gap-6 lg:gap-8">
      <Pagination page={page} />

      <div class="flex w-full flex-col gap-4">
        {page.data.map((post) => <PostItem post={post} />)}
      </div>

      <div class="pt-4 text-center">
        <a href="/autorias/">
          <button type="button" class="btn" data-variant="link">
            <UserIcon />
            Todas autorias
          </button>
        </a>

        <a href="/">
          <button type="button" class="btn" data-variant="link">
            <HouseIcon />
            Voltar ao início
          </button>
        </a>
      </div>
    </div>
  </section>
</Main>

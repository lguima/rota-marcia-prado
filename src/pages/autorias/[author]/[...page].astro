---
import type { GetStaticPaths } from 'astro'
import { type CollectionEntry } from 'astro:content'

import content from '@config/content.mjs'
import { getPublishedArticles } from '@utils/collections/article'

import Main from '@layouts/Main.astro'
import Pagination from '@components/molecules/Pagination.astro'
import PostItem from '@components/molecules/PostItem.astro'
import HouseIcon from '@components/atoms/HouseIcon.astro'
import UserIcon from '@components/atoms/UserIcon.astro'

export const getStaticPaths = (async ({ paginate }) => {
  const allPosts = await getPublishedArticles()
  const allAuthors = [...new Set(allPosts.map((post) => post.data.author))]

  return allAuthors.flatMap((author) => {
    const authorSlug = author.toLowerCase().replace(/\s+/g, '-')
    const authorPosts = allPosts
      .filter((post) => post.data.author === author)
      .sort(
        (a, b) =>
          new Date(b.data.pubDate).valueOf() -
          new Date(a.data.pubDate).valueOf(),
      )

    return paginate(authorPosts, {
      params: {
        author: authorSlug,
      },
      props: {
        author,
        authorSlug,
      },
      pageSize: content.authors.pagination.pageSize,
    })
  })
}) satisfies GetStaticPaths

type Props = {
  author: string
  authorSlug: string
  page: {
    data: CollectionEntry<'article'>[]
    currentPage: number
    lastPage: number
    size: number
    total: number
    url: {
      current: string
      next?: string
      prev?: string
    }
  }
}

const { author, authorSlug, page } = Astro.props
const pageTitle =
  page.currentPage === 1
    ? `Publicações por ${author}`
    : `Publicações por ${author} - Página ${page.currentPage}`
---

<Main title={pageTitle} description={`Publicações de autoria de ${author}`}>
  <section class="py-6 lg:py-10">
    <div class="mx-auto flex max-w-7xl flex-col gap-12 px-5 lg:gap-16 lg:px-8">
      <div
        class="mx-auto flex w-full max-w-3xl flex-col items-center gap-3 text-center"
      >
        <h1
          class="text-3xl font-medium tracking-tight text-balance lg:text-4xl"
        >
          {author}
        </h1>
        <p class="text-muted-foreground max-w-2xl text-base text-pretty">
          {page.total}&nbsp;
          {page.total === 1 ? 'publicação' : 'publicações'} por {author}
        </p>
      </div>
    </div>
  </section>

  <section class="py-6 lg:py-10">
    <div class="mx-auto flex max-w-7xl flex-col gap-6 px-5 lg:gap-8 lg:px-8">
      <Pagination page={page} />

      <div class="flex w-full flex-col gap-4">
        {page.data.map((post) => <PostItem post={post} />)}
      </div>

      <div class="pt-4 text-center">
        <a href="/autorias/">
          <button type="button" class="btn" data-variant="link">
            <UserIcon />
            Todas autorias
          </button>
        </a>

        <a href="/">
          <button type="button" class="btn" data-variant="link">
            <HouseIcon />
            Voltar ao início
          </button>
        </a>
      </div>
    </div>
  </section>
</Main>

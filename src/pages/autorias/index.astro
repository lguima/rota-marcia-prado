---
import { getPublishedArticles } from '@utils/collections/article'
import Main from "@layouts/Main.astro"

// Get all articles and extract unique authors
const allPosts = await getPublishedArticles()
const authorMap = new Map()

allPosts.forEach((post) => {
  const author = post.data.author
  if (authorMap.has(author)) {
    authorMap.set(author, authorMap.get(author) + 1)
  } else {
    authorMap.set(author, 1)
  }
})

// Convert to array and sort alphabetically
const authorsCount = Array.from(authorMap.entries())
  .map(([author, count]) => ({ author, count }))
  .sort((a, b) => a.author.localeCompare(b.author))
---

<Main title="Autorias" description="Navegue pelos artigos por autoria">
  <section class="py-6 lg:py-10">
    <div class="flex flex-col gap-12 lg:gap-16">
      <div class="flex w-full max-w-3xl flex-col gap-3 mx-auto items-center text-center">
        <h1 class="text-3xl font-medium tracking-tight text-balance lg:text-4xl">
          Autorias
        </h1>
        <p class="text-muted-foreground max-w-2xl text-base text-pretty">
          Artigos organizados por autoria
        </p>
      </div>
    </div>
  </section>

  <section class="py-6 lg:py-10">
    <div class="flex flex-col gap-3 lg:gap-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
        {
          authorsCount.map(({ author, count }) => (
            <a
              href={`/autorias/${author.toLowerCase().replace(/\s+/g, "-")}/`}
              class="item"
              data-variant="outline"
            >
              <section>
                <h3 class="text-lg">{author}</h3>
              </section>
              <section>
                <p class="flex flex-col items-center gap-3">
                  <span class="badge">
                    {count}
                  </span>
                </p>
              </section>
            </a>
          ))
        }
      </div>

      <div class="pt-4 text-center">
        <a href="/">
          <button type="button" class="btn" data-variant="link">
            <svg class="lucide lucide-arrow-left-icon lucide-arrow-left" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg> Voltar ao início
          </button>
        </a>
      </div>
    </div>
  </section>
</Main>

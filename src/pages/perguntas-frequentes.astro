---
import { getFaqs } from '@utils/collections/faq'
import { getFaqSchema } from '@utils/structuredData'

import Main from '@layouts/Main.astro'
import Accordion from '@components/organisms/Accordion.astro'
import AccordionDetails from '@components/molecules/AccordionDetails.astro'
import PageHeader from '@components/molecules/PageHeader.astro'
import HouseIcon from '@components/atoms/HouseIcon.astro'

const pageName = 'Perguntas Frequentes (FAQ)'
const pageDescription =
  'Dúvidas frequentes sobre a Rota Márcia Prado respondidas para facilitar a descida de bicicleta de São Paulo a Santos.'

const breadcrumb = [{ text: pageName }]

const faqs = await getFaqs()

const faqSchema = getFaqSchema(faqs)
---

<Main breadcrumb={breadcrumb} title={pageName} description={pageDescription}>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(faqSchema)}
    slot="structured-data"
  />

  <section class="py-6 lg:py-10">
    <div class="flex flex-col gap-12 lg:gap-16">
      <PageHeader title={pageName} description={pageDescription} />
    </div>
  </section>

  <div class="py-6 lg:py-10">
    <Accordion>
      {faqs.map((faq) => <AccordionDetails faq={faq} />)}
    </Accordion>

    <div class="pt-8 text-center">
      <a href="/">
        <button type="button" class="btn" data-variant="link">
          <HouseIcon />
          Voltar ao início
        </button>
      </a>
    </div>
  </div>
</Main>

---
import type { GetStaticPaths } from 'astro'

import content from '@config/content.mjs'
import { getPublishedArticles } from '@utils/collections/article'

import Main from '@layouts/Main.astro'
import PostItem from '@components/molecules/PostItem.astro'
import Pagination from '@components/molecules/Pagination.astro'
import HouseIcon from '@components/atoms/HouseIcon.astro'

export const getStaticPaths = (async ({ paginate }) => {
  const allPosts = await getPublishedArticles()
  const sortedPosts = allPosts.sort(
    (a, b) =>
      new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf(),
  )

  return paginate(sortedPosts, {
    pageSize: content.posts.pagination.pageSize,
  })
}) satisfies GetStaticPaths

const { page } = Astro.props

const pageTitle =
  page.currentPage === 1
    ? 'Artigos'
    : `Artigos - Página ${page.currentPage}`
---

<Main title={pageTitle}>
  <section class="py-6 lg:py-10">
    <div class="mx-auto flex max-w-7xl flex-col gap-12 px-5 lg:gap-16 lg:px-8">
      <div
        class="mx-auto flex w-full max-w-3xl flex-col items-center gap-3 text-center"
      >
        <h1
          class="text-3xl font-medium tracking-tight text-balance lg:text-4xl"
        >
          Artigos
        </h1>
        <p class="text-muted-foreground max-w-2xl text-base text-pretty">
          Todos os artigos
        </p>
      </div>
    </div>
  </section>

  <section class="py-6 lg:py-10">
    <div class="mx-auto flex max-w-7xl flex-col gap-6 px-5 lg:gap-8 lg:px-8">
      <Pagination page={page} />

      <div class="flex w-full flex-col gap-4">
        {page.data.map((post) => <PostItem post={post} />)}
      </div>

      <div class="pt-4 text-center">
        <a href="/">
          <button type="button" class="btn" data-variant="link">
            <HouseIcon />
            Voltar ao início
          </button>
        </a>
      </div>
    </div>
  </section>
</Main>

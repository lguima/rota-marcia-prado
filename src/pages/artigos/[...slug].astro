---
import { render } from 'astro:content'

import { getPublishedArticles, getSimilarArticles } from '@utils/collections/article'
import { getActiveAlerts } from '@utils/collections/alert'
import { formatDateLong, formatDateShort } from '@utils/date'

import Main from '@layouts/Main.astro'
import FeaturedPost from '@components/molecules/FeaturedPost.astro'
import CategoryTagsPills from '@components/molecules/CategoryTagsPills.astro'
import IconArrowLeft from '@components/atoms/IconArrowLeft.astro'
import IconCalendar from '@components/atoms/IconCalendar.astro'
import IconRotateCcwClock from '@components/atoms/IconRotateCcwClock.astro'
import Separator from '@components/atoms/Separator.astro'

export async function getStaticPaths() {
  const posts = await getPublishedArticles()
  const alerts = await getActiveAlerts()

  return posts.map((post) => {
    const matchedAlert = alerts.find(
      (alert) => alert.data.article.id === post.id,
    )

    return {
      params: { slug: post.id },
      props: {
        post,
        alert: matchedAlert || null,
      },
    }
  })
}

const { post, alert } = Astro.props
const { title, description, publishDate, updateDate, category, author, tags } = post.data
const { Content } = await render(post)

const posts = await getPublishedArticles()
const similarPosts = getSimilarArticles(posts, post)

const breadcrumb = [
  { text: 'Artigos', href: '/artigos/' },
  { text: title }
]
---

<Main breadcrumb={breadcrumb} title={title} description={description}>
  <div class="flex flex-col gap-3 lg:gap-4">
    <article class="flex flex-col gap-8 py-6 lg:py-10">
      <header class="flex flex-col gap-6">
        <CategoryTagsPills
          category={category}
          tags={tags}
          alertSeverity={alert?.data?.severity || null}
        />

        <h1
          class="text-4xl leading-tight font-bold tracking-tight md:text-5xl lg:text-6xl"
        >
          {title}
        </h1>

        <p class="text-muted-foreground text-xl leading-relaxed">
          {description}
        </p>

        <div
          class="flex flex-col justify-between gap-4 pt-4 sm:flex-row sm:items-center"
        >
          <div class="flex items-center gap-3">
            <div>
              <p>
                Por&nbsp;
                <a
                  class="font-semibold hover:underline"
                  href={`/autorias/${author.toLowerCase().replace(/\s+/g, '-')}/`}
                >
                  {author}
                </a>
              </p>
            </div>
          </div>

          <div class="flex flex-col 3xs:flex-row gap-4">
            <div class="text-muted-foreground text-sm">
              <div class="flex items-center gap-1">
                <IconCalendar class="size-4" />
                <span class="hidden xs:inline">{formatDateLong(publishDate)}</span>
                <span class="inline xs:hidden">{formatDateShort(publishDate)}</span>
              </div>
            </div>

            {
              updateDate && (
                <div class="text-muted-foreground text-sm">
                  <div class="flex items-center gap-1">
                    <IconRotateCcwClock class="size-4" />
                    <span class="hidden xs:inline">{formatDateLong(updateDate)}</span>
                    <span class="inline xs:hidden">{formatDateShort(updateDate)}</span>
                  </div>
                </div>
              )
            }
          </div>
        </div>
      </header>

      <Separator />

      <div class="prose prose-gray dark:prose-invert max-w-none">
        <Content />
      </div>

      {
        similarPosts.length == 0 && (
          <div class="pt-4 text-center">
            <a href="/">
              <button type="button" class="btn" data-variant="link">
                <IconArrowLeft />
                Voltar ao início
              </button>
            </a>
          </div>
        )
      }
    </article>
  </div>

  {
    similarPosts.length > 0 && (
      <section class="py-6 lg:py-10" data-pagefind-ignore="all">
        <div class="flex flex-col gap-6 lg:gap-8">
          <Separator />

          <div class="flex gap-5 lg:gap-9">
            <div class="flex w-full max-w-3xl flex-1 flex-col items-start gap-3 text-left">
              <h3 class="text-1xl font-medium tracking-tight text-balance lg:text-2xl">
                Artigos relacionados
              </h3>
            </div>
          </div>

          <div class="grid w-full grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3 lg:gap-9">
            {similarPosts.map((similarPost) => (
              <FeaturedPost post={similarPost} />
            ))}
          </div>

          <div class="pt-4 text-center">
            <a href="/">
              <button type="button" class="btn" data-variant="link">
                <IconArrowLeft />
                Voltar ao início
              </button>
            </a>
          </div>
        </div>
      </section>
    )
  }
</Main>

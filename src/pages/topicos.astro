---
import { getCollection } from "astro:content"
import Main from "@layouts/Main.astro"

// Get all articles and extract unique tags
const allPosts = await getCollection("article")
const allTags = [...new Set(allPosts.flatMap((post) => post.data.tags))].sort()

// Count posts per tag
const tagsCount = allTags.map((tag) => ({
  tag,
  count: allPosts.filter((post) => post.data.tags.includes(tag)).length,
}))
---

<Main title="Tópicos" description="Navegue pelas publicações por tópicos">
  <section class="pt-6 pb-6 lg:pt-10 lg:pb-10">
    <div class="mx-auto flex max-w-7xl flex-col gap-12 px-5 lg:gap-16 lg:px-8">
      <div class="flex w-full max-w-3xl flex-col gap-3 mx-auto items-center text-center">
        <h1 class="text-3xl font-medium tracking-tight text-balance lg:text-4xl">
          Tópicos
        </h1>
        <p class="text-muted-foreground max-w-2xl text-base text-pretty">
           Publicações organizadas por tópico
        </p>
      </div>
    </div>
  </section>

  <section class="pt-6 pb-6 lg:pt-10 lg:pb-10">
    <div class="mx-auto max-w-7xl px-5 lg:px-8 flex flex-col gap-3 lg:gap-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
        {
          tagsCount.map(({ tag, count }) => (
            <a
              href={`/topico/${tag.toLowerCase().replace(/\s+/g, "-")}`}
              class="item"
              data-variant="outline"
            >
              <section>
                <h3 class="text-lg">{tag}</h3>
              </section>
              <section>
                <p class="flex flex-col items-center gap-3">
                  <span class="badge">
                    {count}
                  </span>
                </p>
              </section>
            </a>
          ))
        }
      </div>

      <div class="pt-4 text-center">
        <a href="/">
          <button type="button" class="btn" data-variant="link">
            <svg class="lucide lucide-arrow-left-icon lucide-arrow-left" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg> Voltar ao início
          </button>
        </a>
      </div>
    </div>
  </section>


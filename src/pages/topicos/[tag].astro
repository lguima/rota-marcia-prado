---
import { type CollectionEntry, getCollection } from "astro:content"
import Main from "@layouts/Main.astro"
import PostItem from "@components/molecules/PostItem.astro"

export async function getStaticPaths() {
  const allPosts = await getCollection("article")
  const allTags = [...new Set(allPosts.flatMap((post) => post.data.tags))]

  return allTags.map((tag) => ({
    params: {
      tag: tag.toLowerCase().replace(/\s+/g, "-"),
    },
    props: {
      tag,
      posts: allPosts.filter((post) => post.data.tags.some((postTag) => postTag.toLowerCase().replace(/\s+/g, "-") === tag.toLowerCase().replace(/\s+/g, "-"))).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }))
}

type Props = {
  tag: string
  posts: CollectionEntry<"article">[]
}

const { tag, posts } = Astro.props
---

<Main title={`Publicações sobre ${tag}`} description={`Publicações do tópico ${tag}`}>
  <section class="py-6 lg:py-10">
    <div class="mx-auto flex max-w-7xl flex-col gap-12 px-5 lg:gap-16 lg:px-8">
      <div class="flex w-full max-w-3xl flex-col gap-3 mx-auto items-center text-center">
        <h1 class="text-3xl font-medium tracking-tight text-balance lg:text-4xl">
          {tag}
        </h1>
        <p class="text-muted-foreground max-w-2xl text-base text-pretty">
          {posts.length}&nbsp;
          {posts.length === 1 ? "publicação" : "publicações"} sobre {tag}
        </p>
      </div>
    </div>
  </section>

  <section class="py-6 lg:py-10">
    <div class="mx-auto max-w-7xl px-5 lg:px-8 flex flex-col gap-6 lg:gap-8">
      <div class="flex w-full flex-col gap-4">
        {posts.map((post) => (
          <PostItem post={post} />
        ))}
      </div>

      <div class="pt-4 text-center">
        <a href="/topicos/">
          <button type="button" class="btn" data-variant="link">
            <svg class="lucide lucide-tag-icon lucide-tag" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"/><circle cx="7.5" cy="7.5" r=".5" fill="currentColor"/></svg> Todos tópicos
          </button>
        </a>

        <a href="/">
          <button type="button" class="btn" data-variant="link">
            <svg class="lucide lucide-house-icon lucide-house" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/><path d="M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg> Voltar ao início
          </button>
        </a>
      </div>
    </div>
  </section>
</Main>

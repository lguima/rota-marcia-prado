---
import { type CollectionEntry } from "astro:content"

import { getPublishedArticles } from '@utils/collections/article'

import Main from "@layouts/Main.astro"
import PageHeader from '@components/molecules/PageHeader.astro'
import PostItem from "@components/molecules/PostItem.astro"
import HouseIcon from '@components/atoms/HouseIcon.astro'

export async function getStaticPaths() {
  const allPosts = await getPublishedArticles()
  const allTags = [...new Set(allPosts.flatMap((post) => post.data.tags))]

  return allTags.map((tag) => ({
    params: {
      tag: tag.toLowerCase().replace(/\s+/g, "-"),
    },
    props: {
      tag,
      posts: allPosts.filter((post) => post.data.tags.some((postTag) => postTag.toLowerCase().replace(/\s+/g, "-") === tag.toLowerCase().replace(/\s+/g, "-"))).sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()),
    },
  }))
}

type Props = {
  tag: string
  posts: CollectionEntry<"article">[]
}

const { tag, posts } = Astro.props

const pageDescription = `${posts.length} ${posts.length === 1 ? "artigo" : "artigos"} sobre ${tag}`
---

<Main title={`Artigos sobre ${tag}`} description={`Artigos do tópico ${tag}`} data-pagefind-ignore="all">
  <section class="py-6 lg:py-10">
    <div class="flex flex-col gap-12 lg:gap-16">
      <PageHeader title={tag} description={pageDescription} />
    </div>
  </section>

  <section class="py-6 lg:py-10">
    <div class="flex flex-col gap-6 lg:gap-8">
      <div class="flex w-full flex-col gap-4">
        {posts.map((post) => (
          <PostItem post={post} />
        ))}
      </div>

      <div class="pt-4 text-center">
        <a href="/topicos/">
          <button type="button" class="btn" data-variant="link">
            <svg class="lucide lucide-tag-icon lucide-tag" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"/><circle cx="7.5" cy="7.5" r=".5" fill="currentColor"/></svg> Todos tópicos
          </button>
        </a>

        <a href="/">
          <button type="button" class="btn" data-variant="link">
            <HouseIcon />
            Voltar ao início
          </button>
        </a>
      </div>
    </div>
  </section>
</Main>

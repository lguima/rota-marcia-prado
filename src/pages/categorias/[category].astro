---
import { type CollectionEntry } from "astro:content"
import { getPublishedArticles } from '@utils/collections/article'
import Main from "@layouts/Main.astro"
import PostItem from "@components/molecules/PostItem.astro"

export async function getStaticPaths() {
  const allPosts = await getPublishedArticles()
  const allCategories = [...new Set(allPosts.map((post) => post.data.category))]

  return allCategories.map((category) => ({
    params: {
      category: category.toLowerCase().replace(/\s+/g, "-"),
    },
    props: {
      category,
      posts: allPosts.filter((post) => post.data.category === category).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }))
}

type Props = {
  category: string
  posts: CollectionEntry<"article">[]
}

const { category, posts } = Astro.props
---

<Main title={`Publicações em ${category}`} description={`Publicações na categoria ${category}`}>
  <section class="py-6 lg:py-10">
    <div class="mx-auto flex max-w-7xl flex-col gap-12 px-5 lg:gap-16 lg:px-8">
      <div class="flex w-full max-w-3xl flex-col gap-3 mx-auto items-center text-center">
        <h1 class="text-3xl font-medium tracking-tight text-balance lg:text-4xl">
          {category}
        </h1>
        <p class="text-muted-foreground max-w-2xl text-base text-pretty">
          {posts.length}&nbsp;
          {posts.length === 1 ? "publicação" : "publicações"} na categoria {category}
        </p>
      </div>
    </div>
  </section>

  <section class="py-6 lg:py-10">
    <div class="mx-auto max-w-7xl px-5 lg:px-8 flex flex-col gap-6 lg:gap-8">
      <div class="flex w-full flex-col gap-4">
        {posts.map((post) => (
          <PostItem post={post} />
        ))}
      </div>

      <div class="pt-4 text-center">
        <a href="/categorias/">
          <button type="button" class="btn" data-variant="link">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-archive-icon lucide-archive"><rect width="20" height="5" x="2" y="3" rx="1"/><path d="M4 8v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8"/><path d="M10 12h4"/></svg> Todas categorias
          </button>
        </a>

        <a href="/">
          <button type="button" class="btn" data-variant="link">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-house-icon lucide-house"><path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/><path d="M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg> Voltar ao início
          </button>
        </a>
      </div>
    </div>
  </section>
</Main>

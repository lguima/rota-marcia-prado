---
import { getPublishedArticles } from '@utils/collections/article'
import Main from "@layouts/Main.astro"
import PageHeader from '@components/molecules/PageHeader.astro'

// Get all articles and extract unique categories
const allPosts = await getPublishedArticles()
const allCategories = [...new Set(allPosts.map((post) => post.data.category))].sort()

// Count posts per category
const categoriesCount = allCategories.map((category) => ({
  category,
  count: allPosts.filter((post) => post.data.category === category).length,
}))

const pageName = 'Categorias'

const breadcrumb = [
  { text: 'Artigos', href: '/artigos/' },
  { text: pageName }
];
---

<Main breadcrumb={breadcrumb} title={pageName} description="Navegue pelos artigos por categoria">
  <section class="py-6 lg:py-10">
    <div class="flex flex-col gap-12 lg:gap-16">
      <PageHeader title={pageName} description="Artigos organizados por categoria" />
    </div>
  </section>

  <section class="py-6 lg:py-10">
    <div class="flex flex-col gap-3 lg:gap-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
        {
          categoriesCount.map(({ category, count }) => (
            <a
              href={`/categorias/${category.toLowerCase().replace(/\s+/g, "-")}/`}
              class="item"
              data-variant="outline"
            >
              <section>
                <h3 class="text-lg">{category}</h3>
              </section>
              <section>
                <p class="flex flex-col items-center gap-3">
                  <span class="badge">
                    {count}
                  </span>
                </p>
              </section>
            </a>
          ))
        }
      </div>

      <div class="pt-4 text-center">
        <a href="/">
          <button type="button" class="btn" data-variant="link">
            <svg class="lucide lucide-arrow-left-icon lucide-arrow-left" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg> Voltar ao início
          </button>
        </a>
      </div>
    </div>
  </section>
</Main>

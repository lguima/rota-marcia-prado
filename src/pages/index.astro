---
import { getFeaturedArticles, getLatestArticles, getPublishedArticles } from '@utils/collections/article'
import { getActiveAlerts } from '@utils/collections/alert'
import { getPublishedAnnouncements } from '@utils/collections/announcement'
import Main from "@layouts/Main.astro"
import FeaturedPost from "@components/molecules/FeaturedPost.astro"
import PostItem from "@components/molecules/PostItem.astro"
import Separator from "@components/atoms/Separator.astro"
import TriangleAlertIcon from '@components/atoms/TriangleAlertIcon.astro'
import site from "@config/site.mjs"
import content from "@config/content.mjs"

const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": site.name,
  "alternateName": [site.metadata.alternateName],
  "description": site.metadata.description,
  "url": Astro.site,
};

const alerts = await getActiveAlerts();

const announcements = await getPublishedAnnouncements();

const articles = await getPublishedArticles()
const featuredPosts = getFeaturedArticles(articles)
const latestPosts = getLatestArticles(articles)

const alertsGridCols = { 1: 'lg:grid-cols-1', 2: 'lg:grid-cols-2' }[alerts.length] || 'lg:grid-cols-3';
const announcementsGridCols = { 1: 'lg:grid-cols-1', 2: 'lg:grid-cols-2' }[announcements.length] || 'lg:grid-cols-3';
---

<Main>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(webSiteSchema)} slot="structured-data" />

  {
    alerts.length > 0 && (
      <section class="py-2 lg:py-4">
        <div class="mx-auto max-w-7xl px-5 lg:px-8 flex flex-col gap-3 lg:gap-4">
          <div class={`w-full grid grid-cols-1 md:grid-cols-2 ${alertsGridCols} gap-3`}>
            {alerts.map(alert => (
              <a
                href={`/publicacoes/${alert.data.post.id}/`}
                class={`item items-start border-muted border-l-4 ${alert.data.severity == 1 ? 'border-l-danger' : 'border-l-warning'}`}
                data-variant="outline"
              >
                <figure class={`${alert.data.severity == 1 ? 'text-danger' : 'text-warning'}`}>
                  <TriangleAlertIcon class="size-full" />
                </figure>
                <section>
                  <h3>{alert.data.title}</h3>
                  <p>{alert.data.description}</p>
                </section>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="py-6 lg:py-10">
    <div class="mx-auto flex max-w-7xl flex-col gap-12 px-5 lg:gap-16 lg:px-8">
      <div class="mx-auto flex w-full max-w-3xl flex-col items-center gap-4 text-center">
        <h1 class="font-medium tracking-tight text-balance text-4xl lg:text-6xl">
          {site.name}
        </h1>

        <p class="text-muted-foreground max-w-xl text-lg text-pretty">
          Rota cicloturística que liga a <span class="whitespace-nowrap">Região Metropolitana</span> de <span class="whitespace-nowrap">São Paulo</span> a Santos pela <span class="whitespace-nowrap">Serra do Mar</span>, conhecida como a tradicional <span class="whitespace-nowrap">Descida de Santos</span>
        </p>
      </div>
    </div>
  </section>

  {
    announcements.length > 0 && (
      <section class="py-2 lg:py-4">
        <div class="mx-auto max-w-7xl px-5 lg:px-8 flex flex-col gap-3 lg:gap-4">
          <div class={`w-full grid grid-cols-1 md:grid-cols-2 ${announcementsGridCols} gap-3`}>
            {announcements.map(announcement => (
              <a
                href={`/publicacoes/${announcement.data.post.id}/`}
                class="item items-start border-muted border-l-info border-l-4"
                data-variant="outline"
              >
                <figure class="text-info">
                  <svg class="lucide lucide-megaphone-icon lucide-megaphone size-full" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 6a13 13 0 0 0 8.4-2.8A1 1 0 0 1 21 4v12a1 1 0 0 1-1.6.8A13 13 0 0 0 11 14H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2z"/><path d="M6 14a12 12 0 0 0 2.4 7.2 2 2 0 0 0 3.2-2.4A8 8 0 0 1 10 14"/><path d="M8 6v8"/></svg>
                </figure>
                <section>
                  <h3>{announcement.data.title}</h3>
                  <p>{announcement.data.description}</p>
                </section>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="py-6 lg:py-10">
    <div class="mx-auto flex max-w-7xl flex-col gap-12 px-5 lg:gap-16 lg:px-8">
      <div class="flex gap-5 lg:gap-9">
        <div class="flex w-full max-w-3xl flex-col gap-3 items-start text-left flex-1">
          <h2 class="font-medium tracking-tight text-balance text-3xl lg:text-4xl">
            Publicações em destaque
          </h2>
        </div>
      </div>

      <div class="w-full grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3 lg:gap-9">
        {featuredPosts.length > 0 && (
          featuredPosts.map((post) => (
            <FeaturedPost
              post={post}
            />
          ))
        )}
      </div>
    </div>
  </section>

  <section class="py-6 lg:py-10">
    <div class="mx-auto max-w-7xl px-5 lg:px-8 flex flex-col gap-6 lg:gap-8">
      <Separator />

      <div class="flex gap-5 lg:gap-9">
        <div class="flex w-full max-w-3xl flex-col gap-3 items-start text-left flex-1">
          <h3 class="font-medium tracking-tight text-balance text-1xl lg:text-2xl">
            Publicações recentes
          </h3>
        </div>
        {
          articles.length > content.latestPosts.listSize && (
            <a href="/publicacoes/" class="shrink-0 items-center justify-center gap-2 rounded-md text-sm font-medium whitespace-nowrap transition-all outline-none focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 [&amp;_svg:not([class*='size-'])]:size-4 bg-secondary text-secondary-foreground hover:bg-secondary/80 h-9 px-4 py-2 ml-auto hidden self-end lg:flex">
              <button data-slot="button" data-variant="secondary" data-size="default">
                Ver todas
              </button>
            </a>
          )
        }
      </div>

      <div class="flex w-full flex-col gap-4">
        {latestPosts.map((post) => (
          <PostItem post={post} />
        ))}
      </div>
    </div>
  </section>
</Main>

---
import { getFeaturedArticles, getLatestArticles, getPublishedArticles } from '@utils/collections/article'
import { getActivePriorityAlerts, getActiveSecondaryAlerts } from '@utils/collections/alert'
import Main from "@layouts/Main.astro"
import FeaturedPost from "@components/molecules/FeaturedPost.astro"
import PostItem from "@components/molecules/PostItem.astro"
import Separator from "@components/atoms/Separator.astro"
import PriorityAlerts from '@components/molecules/PriorityAlerts.astro'
import SearchModalTrigger from '@components/molecules/SearchModalTrigger.astro'
import SecondaryAlerts from '@components/molecules/SecondaryAlerts.astro'
import site from "@config/site.mjs"
import content from "@config/content.mjs"

const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": site.name,
  "alternateName": [site.metadata.alternateName],
  "description": site.metadata.description,
  "url": Astro.site,
};

const priorityAlerts = await getActivePriorityAlerts();
const secondaryAlerts = await getActiveSecondaryAlerts();

const articles = await getPublishedArticles()
const featuredPosts = getFeaturedArticles(articles)
const latestPosts = getLatestArticles(articles)
---

<Main data-pagefind-ignore="all">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(webSiteSchema)} slot="structured-data" />

  {
    priorityAlerts.length > 0 && (
      <section class="py-2 lg:py-4">
        <div class="mx-auto max-w-7xl px-5 lg:px-8 flex flex-col gap-3 lg:gap-4">
          <PriorityAlerts alerts={priorityAlerts} />
        </div>
      </section>
    )
  }

  <section class="py-6 lg:py-10">
    <div class="mx-auto flex max-w-7xl flex-col gap-12 px-5 lg:gap-16 lg:px-8">
      <div class="mx-auto flex w-full max-w-3xl flex-col items-center gap-4 text-center">
        <h1 class="font-medium tracking-tight text-balance text-4xl lg:text-6xl">
          {site.name}
        </h1>

        <p class="text-muted-foreground max-w-xl text-lg text-pretty">
          Rota cicloturística que liga a <span class="whitespace-nowrap">Região Metropolitana</span> de <span class="whitespace-nowrap">São Paulo</span> a Santos pela <span class="whitespace-nowrap">Serra do Mar</span>, conhecida como a tradicional <span class="whitespace-nowrap">Descida de Santos</span>
        </p>

        <SearchModalTrigger placeholder="Pesquisar..." />
      </div>
    </div>
  </section>

  {
    secondaryAlerts.length > 0 && (
      <section class="py-2 lg:py-4">
        <div class="mx-auto max-w-7xl px-5 lg:px-8 flex flex-col gap-3 lg:gap-4">
          <SecondaryAlerts alerts={secondaryAlerts} />
        </div>
      </section>
    )
  }

  <section class="py-6 lg:py-10">
    <div class="mx-auto flex max-w-7xl flex-col gap-12 px-5 lg:gap-16 lg:px-8">
      <div class="flex gap-5 lg:gap-9">
        <div class="flex w-full max-w-3xl flex-col gap-3 items-start text-left flex-1">
          <h2 class="font-medium tracking-tight text-balance text-3xl lg:text-4xl">
            Artigos em destaque
          </h2>
        </div>
      </div>

      <div class="w-full grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3 lg:gap-9">
        {featuredPosts.length > 0 && (
          featuredPosts.map((post) => (
            <FeaturedPost
              post={post}
            />
          ))
        )}
      </div>
    </div>
  </section>

  <section class="py-6 lg:py-10">
    <div class="mx-auto max-w-7xl px-5 lg:px-8 flex flex-col gap-6 lg:gap-8">
      <Separator />

      <div class="flex gap-5 lg:gap-9">
        <div class="flex w-full max-w-3xl flex-col gap-3 items-start text-left flex-1">
          <h3 class="font-medium tracking-tight text-balance text-1xl lg:text-2xl">
            Artigos recentes
          </h3>
        </div>
        {
          articles.length > content.latestPosts.listSize && (
            <a href="/artigos/" class="shrink-0 items-center justify-center gap-2 rounded-md text-sm font-medium whitespace-nowrap transition-all outline-none focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 [&amp;_svg:not([class*='size-'])]:size-4 bg-secondary text-secondary-foreground hover:bg-secondary/80 h-9 px-4 py-2 ml-auto hidden self-end lg:flex">
              <button data-slot="button" data-variant="secondary" data-size="default">
                Ver todas
              </button>
            </a>
          )
        }
      </div>

      <div class="flex w-full flex-col gap-4">
        {latestPosts.map((post) => (
          <PostItem post={post} />
        ))}
      </div>
    </div>
  </section>
</Main>
